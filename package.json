{
  "name": "bigbiandan-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --host 127.0.0.1",
    "dev:web:agent": "vite --mode agent --host 127.0.0.1",
    "dev:web:lan": "vite --host 0.0.0.0",
    "dev:web:lan:agent": "vite --mode agent --host 0.0.0.0",
    "agent:server": "node scripts/agent-server.mjs",
    "agent:server:persist": "node scripts/agent-server.mjs --session-store=.agent-state/sessions.json",
    "agent:server:lan": "node scripts/agent-server.mjs --host=0.0.0.0",
    "agent:server:lan:persist": "node scripts/agent-server.mjs --host=0.0.0.0 --session-store=.agent-state/sessions.json",
    "agent:health": "node scripts/agent-health-check.mjs",
    "dev:agent": "run-p dev:web:agent agent:server",
    "dev:agent:persist": "run-p dev:web:agent agent:server:persist",
    "dev:lan": "run-p dev:web:lan:agent agent:server:lan",
    "dev:lan:persist": "run-p dev:web:lan:agent agent:server:lan:persist",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "agent:check": "run-s agent:check:tests build",
    "agent:check:tests": "vitest run src/services/__tests__/agentRuntimeClient.test.ts src/services/__tests__/agentServerRuntime.test.ts src/services/__tests__/formalPlaylistWriteAdapter.test.ts src/services/__tests__/agentWorkflowBrowserCases.test.ts src/services/__tests__/schedulingAgentRuntime.move.test.ts src/services/__tests__/schedulingAgentRuntime.intentInterpreter.test.ts src/services/__tests__/schedulingAgentRuntime.commandMatrix.test.ts src/services/__tests__/schedulingAgentRuntime.nlMatrix.test.ts src/services/__tests__/schedulingAgentRuntimeFacade.test.ts src/services/__tests__/schedulingAgentReactTaskRuntime.test.ts src/services/__tests__/schedulingAgentCommandInventory.test.ts src/services/__tests__/agentLlmContextPackage.test.ts src/services/__tests__/agentLlmIntentEvaluation.test.ts src/services/__tests__/agentLlmRuntimeEvaluation.test.ts src/services/__tests__/agentRealLlmEvaluationCases.test.ts src/services/__tests__/agentRealLlmEvaluationReport.test.ts src/services/__tests__/agentPlaylistPolicy.test.ts src/services/__tests__/runtimeSchedulingDataGateway.test.ts src/services/__tests__/atomicOffsetParser.test.ts src/services/__tests__/atomicContinuationClassifier.test.ts src/services/__tests__/intentRecognizer.test.ts src/services/__tests__/paramExtractor.test.ts src/services/__tests__/demoRuntimeFacade.atomicFallback.test.ts src/services/__tests__/demoRuntimeFacade.playlistState.test.ts src/services/__tests__/demoRuntimeFacade.layoutDraft.test.ts src/services/__tests__/foregroundAgentContextPackage.test.ts src/services/__tests__/foregroundAgentGoalContracts.test.ts src/services/__tests__/foregroundAgentVerificationMatrix.test.ts src/services/__tests__/foregroundVisualTheme.test.ts src/services/__tests__/foregroundWorkspaceState.test.ts src/services/__tests__/llmConfig.test.ts src/services/__tests__/llmClient.browserMock.test.ts src/views/broadcast-plan/__tests__/useBroadcastPlanOrchestration.test.ts src/services/__tests__/runtimeSessionStore.test.ts src/services/__tests__/taskClassifier.test.ts src/services/__tests__/candidateSelectionService.test.ts src/components/dialogue/__tests__/chatPanelQuickActions.test.ts src/components/dialogue/__tests__/chatPanelDetails.test.ts src/components/llm/__tests__/LLMConfigPanel.test.ts",
    "agent:browser:goal37": "node scripts/foreground-browser-goal37.mjs",
    "agent:browser:goal38": "node scripts/foreground-browser-goal37.mjs",
    "agent:eval:llm": "vitest run src/services/__tests__/schedulingAgentRuntime.realLlmEvaluation.test.ts",
    "agent:eval:llm:strict": "node scripts/agent-real-llm-eval-strict.mjs",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "dayjs": "^1.11.20",
    "element-plus": "^2.13.6",
    "lodash-es": "^4.17.23",
    "openai": "^6.32.0",
    "pinia": "^3.0.4",
    "uuid": "^13.0.0",
    "vue": "^3.5.30",
    "vue-router": "^5.0.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.12.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/tsconfig": "^0.9.0",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.51.0",
    "eslint-plugin-vue": "~10.8.0",
    "jiti": "^2.6.1",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.51.0",
    "prettier": "3.8.1",
    "sass-embedded": "^1.98.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-vue-devtools": "^8.0.7",
    "vitest": "^4.1.2",
    "vue-tsc": "^3.2.5"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
